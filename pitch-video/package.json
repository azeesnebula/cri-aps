{
  "name": "cri-pumps-aps-pitch",
  "version": "1.0.0",
  "private": true,
  "description": "Narrated C.R.I Pumps APS pitch with actual dark-mode application captures",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3011",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture.mjs",
    "audio": "python scripts/generate_audio.py",
    "stills": "node scripts/render.mjs --stills",
    "render": "node scripts/render.mjs",
    "watch": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/manrope": "5.2.8",
    "@remotion/bundler": "4.0.536",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "lucide-react": "0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
